{
  "compilerOptions": {
    "strict": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "web/server/**/*.ts",
    "web/test/**/*.ts",
    "web/tools/**/*.ts"
  ]
}
