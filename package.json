{
  "name": "@apothic-ai/pi-rooms",
  "version": "0.1.0",
  "description": "Rooms, DMs and reply-all for pi coding agent sessions. File-based, no daemon.",
  "type": "module",
  "license": "MIT",
  "author": "Apothic AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apothic-AI/pi-rooms.git"
  },
  "homepage": "https://github.com/Apothic-AI/pi-rooms#readme",
  "bugs": {
    "url": "https://github.com/Apothic-AI/pi-rooms/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "rooms",
    "messaging",
    "multi-agent"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "bin": {
    "rooms": "./bin/rooms"
  },
  "files": [
    "index.ts",
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts web/test/*.test.ts",
    "typecheck": "tsc -p .",
    "web": "node --experimental-strip-types --no-warnings web/server/server.ts",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts",
    "web:screenshot": "node --experimental-strip-types --no-warnings web/tools/screenshot.ts",
    "web:demo": "node --experimental-strip-types --no-warnings web/tools/demo-store.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
